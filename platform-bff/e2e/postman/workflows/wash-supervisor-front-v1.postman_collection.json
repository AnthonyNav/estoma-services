        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": {{appointmentVersion}}\n}"
        },
        "url": "{{baseUrl}}/api/v1/wash/appointments/{{appointmentId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cancel intent is durably accepted', () => pm.response.to.have.status(202));",
              "const body = pm.response.json();",
              "pm.test('cancel begins as a pollable operation', () => {",
              "  pm.expect(body.status).to.eql('PENDING');",
              "  pm.expect(body.operationId).to.match(/^[0-9a-f-]{36}$/i);",
              "  pm.expect(body.pollPath).to.eql('/api/v1/operations/' + body.operationId);",
              "});",
              "pm.collectionVariables.set('cancelOperationId', body.operationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Poll cancel operation",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/operations/{{cancelOperationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cancel operation is visible', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const maxAttempts = Number(pm.environment.get('maxPollAttempts') || 30);",
              "const attempts = Number(pm.collectionVariables.get('cancelPollAttempts') || 0);",
              "if (body.status === 'PENDING') {",
              "  pm.collectionVariables.set('cancelPollAttempts', String(attempts + 1));",
              "  pm.test('cancel completes within the polling budget', () => pm.expect(attempts + 1).to.be.below(maxAttempts));",
              "  if (attempts + 1 < maxAttempts) pm.execution.setNextRequest('15 Poll cancel operation');",
              "  else pm.execution.setNextRequest(null);",
              "} else {",
              "  pm.test('cancel succeeds', () => pm.expect(body.status, body.errorCode || 'no error code').to.eql('SUCCEEDED'));",
              "  pm.test('cancel result advances the same aggregate', () => {",
              "    pm.expect(body.data.aggregateId).to.eql(pm.collectionVariables.get('appointmentId'));",
              "    pm.expect(body.data.aggregateVersion).to.eql(2);",
              "  });",
              "  if (body.status === 'SUCCEEDED') pm.collectionVariables.set('appointmentVersion', String(body.data.aggregateVersion));",
              "  else pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
